generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  EXPERT
  ADMIN
}

enum ConsultMode {
  VIDEO // scheduled video call (with live chat alongside)
  CHAT  // scheduled live text chat
  ASYNC // unscheduled question/answer thread
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())

  expertProfile        ExpertProfile?
  patientAppointments  Appointment[]  @relation("PatientAppointments")
  messages             Message[]
  auditLogs            AuditLog[]
}

model ExpertProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      String
  qualifications String
  bio            String
  feeCents       Int      @default(0)
  verified       Boolean  @default(false) // set by admin after credential check

  slots        Slot[]
  appointments Appointment[]
}

model Slot {
  id        String   @id @default(cuid())
  expertId  String
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  booked    Boolean  @default(false)

  appointment Appointment?

  @@index([expertId, startsAt])
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  patient   User              @relation("PatientAppointments", fields: [patientId], references: [id])
  expertId  String
  expert    ExpertProfile     @relation(fields: [expertId], references: [id])
  slotId    String?           @unique
  slot      Slot?             @relation(fields: [slotId], references: [id])
  mode      ConsultMode
  status    AppointmentStatus @default(REQUESTED)
  reason    String
  notes     String?           // expert's clinical notes; visible to patient + expert only
  videoRoom String            @unique @default(cuid())
  createdAt DateTime          @default(now())

  messages Message[]

  @@index([patientId])
  @@index([expertId])
}

model Message {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  body          String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

// Access trail for patient data (compliance: HIPAA/GDPR/DPDP).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String
  createdAt DateTime @default(now())
}
